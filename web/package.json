{
  "name": "harbor-index-audit-viewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node scripts/clean-next.mjs .next-dev",
    "clean:prod": "node scripts/clean-next.mjs .next",
    "prebuild": "node scripts/clean-next.mjs .next",
    "build": "next build",
    "dev": "fuser -k 3000/tcp 2>/dev/null; NEXT_DIST_DIR=.next-dev node scripts/clean-next.mjs .next-dev && node scripts/sync-data.mjs && NEXT_DIST_DIR=.next-dev next dev",
    "dev:fast": "fuser -k 3000/tcp 2>/dev/null; NEXT_DIST_DIR=.next-dev next dev",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
    "diff": "^9.0.0",
    "katex": "^0.17.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-diff-view": "^3.3.3",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3"
  }
}
