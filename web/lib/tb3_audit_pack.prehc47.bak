              "line_end": 88,
              "quote": "L = matrix.shape[0]\n    q = 0.25\n    threshold = scale * compute_kld(matrix)\n\n    positions = []\n    for _ in range(num_runs):\n        for i in range(len(sequence) - L + 1):\n            window = sequence[i:i + L]\n            logodds = 0.0\n            for j, b in enumerate(window):\n                if b in BASE_IDX:\n                    logodds += np.log(matrix[j, BASE_IDX[b]] / q)\n            if logodds > threshold:\n                positions.append(i)\n\n    if not positions:\n        return None\n\n    most_common_position = Counter(positions).most_common(1)[0][0]\n    return most_common_position"
            }
          ]
