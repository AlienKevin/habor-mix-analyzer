              "kind": "trajectory",
              "steps": [
                3
              ],
              "quote": "Minimum k. k* = smallest integer with cos(pi/k) > 1 - 1/(2N), i.e.\n   k* = floor( pi / arccos(1 - 1/(2N)) ) + 1."
            },
