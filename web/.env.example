# Shared secret for /api/annotate (server). Required to enable cloud saves.
ANNOTATION_API_TOKEN=

# Optional: inject the same token at build time so annotators are not prompted.
# For internal studies only — anyone with site access can read this from the bundle.
NEXT_PUBLIC_ANNOTATION_API_TOKEN=

# Vercel Blob (auto-set when you add a Blob store in the Vercel project).
# Without this, local dev writes to web/.data/annotations/ instead.
BLOB_READ_WRITE_TOKEN=
